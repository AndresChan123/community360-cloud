# Copia este archivo como .env y llena tus datos. NUNCA subas el .env al repositorio.
# Cadena de conexion de CockroachDB Cloud (con sslmode=verify-full)
COCKROACH_DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:26257/BASE?sslmode=verify-full
# Ruta al JSON de la cuenta de servicio de Firebase
GOOGLE_APPLICATION_CREDENTIALS=./credenciales/firebase-admin.json
# API Key publica de Firebase Web para intercambio de correo/contrasena por ID Token en el backend
FIREBASE_WEB_API_KEY=TU_FIREBASE_WEB_API_KEY
PORT=3000
